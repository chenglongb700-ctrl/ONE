# AI 总结用的模型。把这个文件复制一份，改名为 .env（.env 不会进 git），填好下面三项，然后重启网站。
# 用的是"OpenAI 兼容"接口，下面任选一家，或者换成别家的地址和模型名。
# 模型名各家经常换代（2026-11 时的写法），报"模型名不对"时去那家的文档里查最新的名字。

# DeepSeek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# 通义千问（阿里云百炼）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-flash

# 豆包（火山方舟）——模型名填你在控制台创建的接入点或模型 ID
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=

# Kimi（月之暗面）
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-32k

# 智谱
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4.7-flash

# 本机的 Ollama（不需要密钥，AI_API_KEY 留空）
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5
